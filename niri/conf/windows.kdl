// 固定名字让 Super+数字不会因动态工作区回收而跳到另一个工作区。
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "10"

window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    draw-border-with-background false
}
// The bundled terminal/AI launchers use transparent backgrounds with native blur.
// 专用终端和 AI 面板使用原生毛玻璃，不影响其他应用的不透明度。
window-rule {
    match app-id=r#"^(kitty|selandia-terminal|selandia-ai)$"#
    background-effect {
        blur true
        xray true
        saturation 1.25
        noise 0.02
    }
}
window-rule {
    match app-id=r#"^selandia-ai$"#
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { proportion 0.86; }
    default-floating-position x=18 y=18 relative-to="top-right"
    focus-ring {
        active-gradient from="#c4b5fd" to="#94dfff" angle=150
    }
}
window-rule {
    match app-id=r#"^(pavucontrol|pavucontrol-qt|org.pulseaudio.pavucontrol|nm-connection-editor|blueman-manager|org.kde.polkit-kde-authentication-agent-1|org.fcitx.fcitx5-config-qt)$"#
    match app-id=r#"^org.kde.systemsettings$"#
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 650; }
}
window-rule {
    match app-id=r#"^(firefox|google-chrome|chromium)$"# title="^(Picture-in-Picture|画中画)$"
    open-floating true
    default-floating-position x=24 y=24 relative-to="bottom-right"
}
window-rule {
    match app-id=r#"^steam_app_"#
    open-fullscreen true
    variable-refresh-rate true
}
window-rule {
    match app-id=r#"^(org.keepassxc.KeePassXC|org.gnome.World.Secrets|1Password)$"#
    block-out-from "screen-capture"
}
