// Selandia · Obsidian Precision · 黑曜精工
// One steel-blue accent, matte slate surfaces, Adwaita Sans + JetBrains Mono.
// 原生背景模糊；xray 复用壁纸缓存，保持文字清晰并降低渲染开销。
blur {
    passes 3
    offset 3.0
    noise 0.0
    saturation 1.1
}
layout {
    gaps 16
    center-focused-column "on-overflow"
    always-center-single-column
    background-color "#0a0e14"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    focus-ring {
        width 2
        active-color "#4c9eff"
        inactive-color "#26334226"
        urgent-color "#f87171"
    }
    border { off; }
    shadow {
        on
        softness 36
        spread 3
        offset x=0 y=10
        color "#00000066"
    }
    tab-indicator {
        position "top"
        gaps-between-tabs 6
        corner-radius 8
        active-color "#4c9eff"
        inactive-color "#f0f4f822"
    }
}
animations {
    workspace-switch { spring damping-ratio=1.0 stiffness=700 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=1.0 stiffness=700 epsilon=0.0001; }
    window-movement { spring damping-ratio=1.0 stiffness=700 epsilon=0.0001; }
    window-open { duration-ms 220; curve "ease-out-expo"; }
    window-close { duration-ms 160; curve "ease-out-quad"; }
}
overview {
    zoom 0.4
    backdrop-color "#0a0e14"
}

layer-rule {
    // SwayNC includes invisible margins in its surfaces; keep its glass CSS only.
    // 通知组件的透明边距属于窗口表面，不强制模糊，避免边缘出现矩形色块。
    match namespace="^(launcher|selandia-.*)$"
    // Niri 26.04 also uses this radius for the compositor's blur geometry.
    // 与面板外框保持一致，避免圆角外露出矩形模糊区域。
    geometry-corner-radius 18
    background-effect {
        blur true
        xray true
        saturation 1.1
        noise 0.0
    }
}
layer-rule {
    match namespace="^(selandia-bar-.*|selandia-island)$"
    geometry-corner-radius 18
}
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 24
    shadow {
        on
        softness 40
        spread 4
        offset x=0 y=12
        color "#060a1466"
    }
}
