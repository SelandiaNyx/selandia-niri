// 在现有桌面中嵌套试用布局：niri --config niri/preview.kdl
// 不启动后台服务、不更新 D-Bus/systemd 环境。
include "conf/input.kdl"
include "conf/appearance.kdl"
include "theme/theme.kdl"
include "conf/windows.kdl"
include "conf/binds.kdl"
prefer-no-csd
hotkey-overlay { skip-at-startup; }
// A readable preview on high-density displays / 高分屏上的清晰预览。
output "winit" { scale 1.5; }
binds {
    Mod+Return hotkey-overlay-title="终端" { spawn "kitty"; }
    Mod+Space hotkey-overlay-title="启动器" { spawn "fuzzel"; }
    Mod+L hotkey-overlay-title=null { toggle-overview; }
    Mod+Shift+Escape hotkey-overlay-title="退出预览" { quit skip-confirmation=true; }
}
