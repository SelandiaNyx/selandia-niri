#!/usr/bin/env bash
set -euo pipefail
# Eww's GTK3 input helper must never be inherited by GTK4 launchers.
if [[ -n "${SELANDIA_EWW_INPUT_LIB:-}" ]]; then
    IFS=: read -ra preload_parts <<< "${LD_PRELOAD:-}"
    filtered_preload=()
    for preload_part in "${preload_parts[@]}"; do
        [[ -z "$preload_part" || "$preload_part" == "$SELANDIA_EWW_INPUT_LIB" ]] || filtered_preload+=("$preload_part")
    done
    if ((${#filtered_preload[@]})); then
        LD_PRELOAD=$(IFS=:; printf '%s' "${filtered_preload[*]}")
        export LD_PRELOAD
    else
        unset LD_PRELOAD
    fi
fi
unset SELANDIA_EWW_INPUT_LIB SELANDIA_EWW_GEOMETRY SELANDIA_EWW_EXCLUSIVE_ZONE
base=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
# A terminal opened from an already-running panel still gets the newly selected
# user locale. Skip the Python re-exec when no session_locale is configured or
# for pure control hotkeys that never spawn user apps.
case "${1:-}" in
    volume|brightness|notification-toggle|bar-toggle|reload|theme-reload|lock|sleep|power|clipboard|clipboard-clear|idle-toggle|bar-backend|daily-components) ;;
    *)
        lang_state=${XDG_STATE_HOME:-$HOME/.local/state}/selandia-niri/language.json
        if [[ "${SELANDIA_LANGUAGE_WRAPPED:-0}" != 1 && -f "$base/shell/language_settings.py" && -r "$lang_state" ]]; then
            lang_raw=$(<"$lang_state")
            if [[ "$lang_raw" =~ \"session_locale\"[[:space:]]*:[[:space:]]*\"[^\"] ]]; then
                export SELANDIA_LANGUAGE_WRAPPED=1
                exec python3 -B "$base/shell/language_settings.py" exec "$0" "$@"
            fi
        fi
        ;;
esac
unset SELANDIA_LANGUAGE_WRAPPED
launcher_config=$base/theme/fuzzel.ini
[[ -f "$launcher_config" ]] || launcher_config=$base/fuzzel/fuzzel.ini
ui_language=
resolve_ui_language() {
    [[ -z "$ui_language" ]] || return 0
    ui_language=${LC_ALL:-${LC_MESSAGES:-${LANG:-en_US}}}
    if [[ -f "$base/shell/i18n.py" ]]; then
        ui_language=$(python3 -B "$base/shell/i18n.py" language)
    fi
}
tr() {
    resolve_ui_language
    if [[ "$ui_language" == zh* ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

notify() { notify-send -a 'Selandia Niri' "$@" || true; }
# dmenu modes must never show the application placeholder: each gets a neutral
# single-language hint next to its own action prompt.
menu() { fuzzel --config "$launcher_config" --dmenu "$@" --placeholder "$(tr 'Type to filter' '输入以筛选')"; }
confirm() {
    local answer
    answer=$(printf '%s\n' "$(tr 'Cancel' '取消')" "$(tr 'Confirm' '确认')" | menu --prompt "$1  ›  ") || return 1
    [[ "$answer" == "$(tr 'Confirm' '确认')" ]]
}
first_app() {
    local app
    for app in "$@"; do
        if command -v "$app" >/dev/null 2>&1; then exec "$app"; fi
    done
    notify "$(tr 'Application not installed' '应用未安装')" "$(tr 'Available choices:' '可选：') $*"
    return 1
}

case "${1:-}" in
    notification-toggle) exec swaync-client -t ;;
    bar-backend) exec python3 -B "$base/shell/component_preferences.py" bar "${2:-}" ;;
    daily-components) exec python3 -B "$base/shell/component_preferences.py" daily ;;
    control|quick|system|monitor|appearance|wallpapers|sound|displays|input|desktop|network|bluetooth|hardware|storage|applications|language|power-settings|time|startup|services|logs|packages|notifications|security|preferences|shortcuts|ai|calendar)
        panel_mode=$1
        [[ "$panel_mode" != power-settings ]] || panel_mode=power
        exec python3 -B "$base/shell/panel.py" "$panel_mode"
        ;;
    install-tool)
        case "${2:-}" in
            system-config-printer|gnome-disk-utility|fcitx5-configtool|firewall-config|seahorse|network-manager-applet|blueman) ;;
            *) exit 2 ;;
        esac
        exec python3 -B "$base/shell/component_preferences.py" terminal --class selandia-settings --hold \
            sudo pacman -Syu --needed -- "$2"
        ;;
    password) exec python3 -B "$base/shell/component_preferences.py" terminal --class selandia-settings --hold passwd ;;
    updates|repair|status|check)
        operation=$1
        [[ "$operation" != updates ]] || operation=update
        controller=$base/../control.sh
        [[ -x "$controller" ]] || { notify "$(tr 'Controller missing' '控制脚本缺失')" "$controller"; exit 1; }
        exec python3 -B "$base/shell/component_preferences.py" terminal --class selandia-settings \
            --title "$(tr 'Desktop maintenance' '桌面维护') — $operation" --hold "$controller" "$operation"
        ;;
    system-monitor)
        for monitor in btop htop top; do
            if command -v "$monitor" >/dev/null; then
                exec python3 -B "$base/shell/component_preferences.py" terminal --class selandia-monitor \
                    --title "$(tr 'System monitor' '系统监控')" "$monitor"
            fi
        done
        notify "$(tr 'System monitor unavailable' '系统监控不可用')" "$(tr 'Install btop, htop or procps-ng' '请安装 btop、htop 或 procps-ng')"
        exit 1
        ;;
    launcher)
        # Override at launch time so a language switch applies immediately,
        # without regenerating the theme. Never the bilingual template text.
        exec python3 -B "$base/shell/component_preferences.py" launcher
        ;;
    launch)
        case "${2:-}" in
            terminal)
                exec python3 -B "$base/shell/component_preferences.py" terminal
                ;;
            files) first_app dolphin nautilus thunar ;;
            browser) first_app google-chrome-stable firefox chromium ;;
            editor) first_app code codium kate ;;
            audio) first_app pavucontrol-qt pavucontrol ;;
            network) first_app nm-connection-editor ;;
            bluetooth) first_app blueman-manager ;;
            input) first_app fcitx5-config-qt fcitx5-configtool ;;
            *) exit 2 ;;
        esac
        ;;
    clipboard)
        selection=$(cliphist list | menu --prompt "$(tr 'Clipboard' '剪贴板')  ›  ") || exit 0
        [[ -n "$selection" ]] || exit 0
        printf '%s\n' "$selection" | cliphist decode | wl-copy
        ;;
    clipboard-clear)
        confirm "$(tr 'Clear clipboard?' '清空剪贴板？')" || exit 0
        cliphist wipe
        wl-copy --clear
        notify "$(tr 'Clipboard history cleared' '剪贴板历史已清空')"
        ;;
    lock)
        exec python3 -B "$base/shell/lock_session.py"
        ;;
    power)
        # The native menu holds every action as a button: no search field, and
        # the session-ending choices confirm inside the same surface. It only
        # reports the action, so lock and suspend keep their entry points above
        # and power_actions.py stays the one path the automatic timer shares.
        selection=$(python3 -B "$base/shell/power_menu.py") || exit 0
        case "$selection" in
            lock) exec "$0" lock ;;
            sleep) exec "$0" sleep ;;
            logout) niri msg action quit --skip-confirmation ;;
            restart) systemctl reboot ;;
            shutdown) systemctl poweroff ;;
            *) exit 2 ;;
        esac
        ;;
    sleep)
        # The same entry point the automatic timer uses. It refuses before
        # locking when this project blocks sleep, and reports every failure.
        if ! message=$(python3 -B "$base/shell/power_actions.py" suspend 2>&1); then
            notify "$(tr 'Sleep not started' '未进入睡眠')" "$message"
            exit 1
        fi
        ;;
    volume)
        case "${2:-}" in
            up) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
            down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
            mic) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
            *) exit 2 ;;
        esac
        if [[ "$2" == mic ]]; then
            value=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)
            notify -h string:x-canonical-private-synchronous:microphone -t 1200 "$(tr 'Microphone' '麦克风')" "$value"
        elif ! python3 -B "$base/shell/island.py" show volume; then
            value=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
            notify -h string:x-canonical-private-synchronous:volume -t 1200 "$(tr 'Volume' '音量')" "$value"
        fi
        ;;
    brightness)
        [[ "${2:-}" == up || "${2:-}" == down ]] || exit 2
        if ! value=$(python3 -B "$base/shell/brightness.py" step "$2" 2>&1); then
            notify "$(tr 'Brightness unavailable' '无法调节亮度')" "$value"
            exit 1
        fi
        if ! python3 -B "$base/shell/island.py" show brightness; then
            notify -h string:x-canonical-private-synchronous:brightness -t 1200 "$(tr 'Brightness' '亮度')" "$value"
        fi
        ;;
    idle-toggle)
        if ! result=$(python3 -B "$base/shell/sleep_guard.py" toggle 2>&1); then
            notify "$(tr 'Power setting failed' '电源设置失败')" "$result"
            exit 1
        fi
        notify "$(tr 'Power settings updated' '电源设置已更新')" "$result"
        ;;
    wallpaper)
        path=${2:-}
        if [[ -z "$path" ]]; then
            exec python3 -B "$base/shell/panel.py" wallpapers
        fi
        [[ -f "$path" && "$path" != *$'\n'* ]] || { notify "$(tr 'Image is missing or its path contains a newline' '图片不存在或路径含换行')"; exit 1; }
        exec python3 -B "$base/shell/wallpaper.py" set "$path"
        ;;
    reload)
        niri validate -c "$base/config.kdl"
        python3 -B "$base/shell/reload_components.py" all
        notify "$(tr 'Desktop reloaded' '界面已重载')" "$(tr 'Niri configuration is applied automatically when saved.' 'Niri 配置在保存时自动加载。')"
        ;;
    theme-reload)
        niri validate -c "$base/config.kdl"
        exec python3 -B "$base/shell/reload_components.py" theme
        ;;
    bar-toggle) exec python3 -B "$base/shell/component_preferences.py" toggle-bar ;;
    *) printf '%s\n' "$(tr 'Usage' '用法'): desktop {control|quick|system|appearance|wallpapers|sound|displays|input|desktop|network|hardware|applications|language|power-settings|time|startup|services|notifications|security|shortcuts|ai|calendar|updates|repair|status|check|system-monitor|launcher|launch APP|install-tool PACKAGE|password|clipboard|clipboard-clear|lock|sleep|power|volume up/down/mute/mic|brightness up/down|idle-toggle|wallpaper [IMAGE]|reload|theme-reload|bar-toggle|notification-toggle|bar-backend|daily-components}"; exit 2 ;;
esac
