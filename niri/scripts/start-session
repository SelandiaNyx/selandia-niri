#!/usr/bin/env bash
set -euo pipefail
# 嵌套预览不接管当前桌面的服务或环境。
session_state=$(systemctl --user show --property=ActiveState --value niri.service)
if [[ "$session_state" != active && "$session_state" != activating ]]; then
    printf '%s\n' '桌面组件仅在 niri-session 正式会话中启动。' >&2
    exit 0
fi
base=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
python3 -B "$base/shell/language_settings.py" sync-session
python3 -B "$base/shell/ui_assets.py"
systemctl --user unset-environment XDG_MENU_PREFIX
systemctl --user import-environment NIRI_SOCKET WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME XMODIFIERS QT_IM_MODULE
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME XMODIFIERS QT_IM_MODULE XDG_MENU_PREFIX=
mkdir -p "$HOME/Pictures/Screenshots"
systemctl --user start selandia-niri.target
