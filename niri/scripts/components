#!/usr/bin/env bash
set -euo pipefail
base=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
case "${1:-}" in
    # Compatibility service instance name; Eww is the sole bar backend.
    waybar)
        exec python3 -B "$base/shell/bar_backend.py"
        ;;
    notifications)
        notification_style=$base/theme/swaync.css
        notification_config=$base/swaync/config.json
        [[ ! -f "$base/theme/swaync.json" ]] || notification_config=$base/theme/swaync.json
        [[ -f "$notification_style" ]] || notification_style=$base/swaync/style.css
        exec swaync -c "$notification_config" -s "$notification_style"
        ;;
    wallpaper) exec python3 -B "$base/shell/wallpaper.py" run ;;
    idle)
        idle_config=$base/swayidle/config
        [[ ! -f "$base/swayidle/managed.conf" ]] || idle_config=$base/swayidle/managed.conf
        exec swayidle -w -C "$idle_config"
        ;;
    sleep-lock) exec swayidle -w -C "$base/swayidle/sleep.conf" ;;
    awake)
        # This instance is started explicitly, never by the desktop target.
        # It stops with the Niri session through the template's PartOf= setting.
        exec systemd-inhibit --what=idle:sleep --mode=block --who='Selandia Niri' \
            --why='Niri Stay awake: pause idle handling and prevent sleep' /usr/bin/sleep infinity
        ;;
    lock-*)
        # One instance per Wayland display. It runs in its own unit cgroup, so
        # stopping or restarting idle, sleep-lock or the control center cannot
        # end a lock this service already confirmed.
        exec python3 -B "$base/shell/lock_client.py" "${1#lock-}"
        ;;
    clipboard-text) exec wl-paste --type text --watch cliphist store ;;
    clipboard-image) exec wl-paste --type image --watch cliphist store ;;
    polkit)
        if python3 -B -c "import gi; gi.require_version('PolkitAgent', '1.0'); from gi.repository import PolkitAgent" 2>/dev/null; then
            exec python3 -B "$base/shell/polkit_agent.py"
        fi
        for agent in /usr/lib/polkit-kde-authentication-agent-1 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do
            if [[ -x "$agent" ]]; then
                exec "$agent"
            fi
        done
        printf '%s\n' '找不到 Polkit 验证代理，请安装 polkit。' >&2
        exit 1
        ;;
    *) printf '未知组件：%s\n' "${1:-}" >&2; exit 2 ;;
esac
