{
  "layer": "top",
  "position": "top",
  "height": 46,
  "spacing": 2,
  "margin-top": 12,
  "margin-left": 18,
  "margin-right": 18,
  "modules-left": [
    "custom/launcher",
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/layout",
    "custom/ai",
    "custom/shortcuts",
    "custom/system",
    "pulseaudio",
    "network",
    "battery",
    "tray",
    "custom/notification",
    "custom/control"
  ],
  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "Applications · 应用启动器\nSuper + Space · Right click: Overview / 右键：总览",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" launcher",
    "on-click-right": "niri msg action toggle-overview"
  },
  "niri/workspaces": {
    "format": "{name}",
    "all-outputs": false
  },
  "niri/window": {
    "format": "{}",
    "max-length": 18,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%a  %m.%d   %H:%M}",
    "format-alt": "{:%Y-%m-%d   %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b><span color='#94dfff'>{}</span></b>"
      }
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 5,
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" sound",
    "on-click-right": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" volume mute",
    "tooltip-format": "{desc}\nVolume · 音量 {volume}%\nClick: sound devices / 点击声音设备 · Scroll: volume / 滚动调音量\nRight click: mute / 右键静音"
  },
  "network": {
    "interval": 2,
    "family": "ipv4_6",
    "format-wifi": "󰖩 ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-ethernet": "󰈀 ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname}  {ipaddr}\n{essid}\nClick: system monitor · 点击：系统监控\nRight click: connections · 右键：连接设置",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" system",
    "on-click-right": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" network",
    "tooltip-format-disconnected": "Offline · 未连接网络"
  },
  "custom/system": {
    "exec": "python3 -B \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/shell/metrics.py\" --waybar",
    "return-type": "json",
    "restart-interval": 3,
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" system",
    "on-click-right": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" control"
  },
  "battery": {
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
    "tooltip-format": "Battery · 电池 {capacity}%\n{timeTo}"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂛",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/components\" notification-stream",
    "restart-interval": 3,
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d"
  },
  "custom/layout": {
    "exec": "python3 -B \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/shell/bar_layout.py\" ensure",
    "restart-interval": 15,
    "return-type": "json",
    "tooltip": false
  },
  "custom/ai": {
    "format": "✦ AI",
    "tooltip-format": "AI sidebar · AI 侧栏\nSuper + A",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" ai"
  },
  "custom/shortcuts": {
    "format": "󰌌",
    "tooltip-format": "Keyboard shortcuts · 快捷键大全\nSuper + /",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" shortcuts"
  },
  "custom/control": {
    "format": "󰒓",
    "tooltip-format": "Control Center · 控制中心\nSuper + I",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/desktop\" control"
  }
}
